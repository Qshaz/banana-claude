# Copy this to .env and fill in your values

# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Password for the /dashboard page (you and your parents use this)
DASHBOARD_PASSWORD=choose_a_password_here

# Random secret for Flask sessions (anything long and random is fine)
SECRET_KEY=change_this_to_something_random

# Where to store uploaded bill photos (default: ./uploads)
# UPLOAD_FOLDER=uploads

# Where to store the database (default: ./expenses.db)
# DB_PATH=expenses.db

# Port to run on (default: 5000)
# PORT=5000

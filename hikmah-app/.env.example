# Copy this to .env and fill in your values

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Gemini API key (for embeddings — free tier)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic / Claude API key (for answering questions)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Your app's public URL (set this to your Cloud Run URL after deploying)
APP_URL=https://your-app-url.run.app

# A random secret string — used to sign session cookies
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Where to store data (ChromaDB + books.json)
DATA_DIR=/data
